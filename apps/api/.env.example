# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dechub_cloud

# Long random string (at least 32 characters). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the web app lives (used in invite and reset links, and CORS)
WEB_URL=http://localhost:3000

# Optional: set to .dechub.ai in production if the API is on its own subdomain
COOKIE_DOMAIN=

# Website origins allowed to post form leads (comma separated)
INBOUND_ALLOWED_ORIGINS=https://dechub.in,https://www.dechub.in,https://bridge.dechub.ai

# Number of proxies in front of the API (Vercel + Render = 2). Used to read the visitor IP.
TRUST_PROXY_HOPS=2

# Email (Resend). Leave empty in development: links are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM=Dechub Cloud <no-reply@dechub.ai>

# Used by `npm run seed` to create the first organization and admin
SEED_ORG_NAME=Dechub
SEED_ADMIN_NAME=Prasanna
SEED_ADMIN_EMAIL=prasanna@dechub.in
SEED_ADMIN_PASSWORD=change-this-password
